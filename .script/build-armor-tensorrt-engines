#!/usr/bin/env bash
# Build TensorRT engines for L2 (shenzhen-0708) and L3 (armor-number).
# L2: static [1,3,640,640] – no shape flags needed.
# L3: dynamic [batch,3,H,W] – we always run with batch=1, 224x224 in C++,
#     so fix the profile to that exact shape.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
MODEL_DIR="${ROOT_DIR}/ros_ws/src/radar_camera/model"

L2_ONNX="${MODEL_DIR}/shenzhen-0708.onnx"
L2_ENGINE="${MODEL_DIR}/shenzhen-0708_fp16.engine"
L2_BENCH="${L2_ENGINE}.benchmark.json"

L3_ONNX="${MODEL_DIR}/armor-number.onnx"
L3_ENGINE="${MODEL_DIR}/armor-number_fp16.engine"
L3_BENCH="${L3_ENGINE}.benchmark.json"

command -v trtexec >/dev/null || { echo "trtexec not found" >&2; exit 1; }

test -f "${L2_ONNX}" || { echo "ONNX not found: ${L2_ONNX}" >&2; exit 1; }
test -f "${L3_ONNX}" || { echo "ONNX not found: ${L3_ONNX}" >&2; exit 1; }

echo "=== [L2] Building shenzhen-0708_fp16.engine ==="
trtexec \
    --onnx="${L2_ONNX}" \
    --saveEngine="${L2_ENGINE}" \
    --memPoolSize=workspace:4096M \
    --builderOptimizationLevel=3 \
    --skipInference

echo "=== [L2] Benchmark ==="
trtexec \
    --loadEngine="${L2_ENGINE}" \
    --duration=20 \
    --warmUp=200 \
    --iterations=200 \
    --includeDataTransfers \
    --exportTimes="${L2_BENCH}"

echo "=== [L3] Building armor-number_fp16.engine (fixed 1x3x224x224) ==="
trtexec \
    --onnx="${L3_ONNX}" \
    --saveEngine="${L3_ENGINE}" \
    --minShapes=images:1x3x224x224 \
    --optShapes=images:1x3x224x224 \
    --maxShapes=images:1x3x224x224 \
    --memPoolSize=workspace:4096M \
    --builderOptimizationLevel=3 \
    --skipInference

echo "=== [L3] Benchmark ==="
trtexec \
    --loadEngine="${L3_ENGINE}" \
    --shapes=images:1x3x224x224 \
    --duration=20 \
    --warmUp=200 \
    --iterations=200 \
    --includeDataTransfers \
    --exportTimes="${L3_BENCH}"

echo ""
echo "Engines:"
echo "  L2: ${L2_ENGINE}"
echo "  L3: ${L3_ENGINE}"
echo "Benchmarks:"
echo "  L2: ${L2_BENCH}"
echo "  L3: ${L3_BENCH}"
